NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated, server-only exact email allowlist. ADMIN_EMAIL remains a fallback.
ADMIN_EMAILS=owner@example.com,second-admin@example.com

# Local LapLapLa checkout used by the development-only Quest Print Lab launcher.
NEXT_PUBLIC_LAPLAPLA_URL=http://localhost:3000
# Optional full URL override when the Print Lab route is hosted elsewhere.
# NEXT_PUBLIC_QUEST_PRINT_LAB_URL=http://localhost:3000/internal/quest-print-lab
